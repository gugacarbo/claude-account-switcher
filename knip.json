{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["shadcn", "tailwindcss", "tw-animate-css"]
    }
  },
  "ignoreBinaries": ["go", "gofmt", "golangci-lint", "gitleaks", "govulncheck"]
}
